{
  "name": "cityvizor-client",
  "version": "5.7.0",
  "description": "CityVizor web client for CityVizor API (Server)",
  "homepage": "https://cityvizor.cz/",
  "repository": "otevrena-data-mfcr/CityVizor",
  "main": "server/server.js",
  "scripts": {
    "build": "ng build --configuration production",
    "start-dev": "npm run build && ng serve --disable-host-check --configuration=local --host 0.0.0.0 --poll 1000",
